# Copy this file to .env and fill in your own values. Never commit .env.

# ==========================================
# Backend Server Configuration (server/.env)
# ==========================================

# Port the Express backend API server listens on
PORT=5000

# Environment mode (development / production)
NODE_ENV=development

# Google Gemini API Key for server-side structured AI generation
# (Get your key from Google AI Studio: https://aistudio.google.com/)
# If left empty, LectureLens automatically runs in deterministic offline AI mode!
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier to invoke for structured extraction
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Frontend Client Configuration (client/.env)
# ==========================================

# Optional: Direct client-side Gemini API key if making browser-direct calls
# NOTE: Keys prefixed with VITE_ are exposed to the browser.
# For public deployment, keep AI calls on the backend or serverless functions.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Public application URL for production deployment or callbacks
VITE_PUBLIC_APP_URL=https://your-deployed-url.example.com

# Optional: Supabase project URL for live authentication (optional — app works fully offline if omitted)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Optional: Supabase anonymous public API key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
